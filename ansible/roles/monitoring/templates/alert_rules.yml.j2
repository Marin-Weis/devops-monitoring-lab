# Managed by Ansible — do not edit manually.
groups:
  - name: lab-app-alerts
    rules:
      - alert: AppDown
        expr: up{job="lab-app"} == 0
        for: {{ alert_for_duration }}
        labels:
          severity: critical
        annotations:
          summary: "Application {% raw %}{{ $labels.instance }}{% endraw %} is down"
          description: "Prometheus has been unable to scrape /metrics for {{ alert_for_duration }}."

      - alert: HighErrorRate
        expr: |
          sum(rate(app_http_requests_total{status=~"5.."}[1m]))
            /
          sum(rate(app_http_requests_total[1m])) > {{ alert_error_ratio_threshold }}
        for: {{ alert_for_duration }}
        labels:
          severity: warning
        annotations:
          summary: "5xx error rate above {{ (alert_error_ratio_threshold * 100) | int }}%"
          description: "{% raw %}{{ $value | humanizePercentage }}{% endraw %} of requests are failing (1m window)."

      - alert: HighLatencyP95
        expr: |
          histogram_quantile(0.95,
            sum by (le) (rate(app_http_request_duration_seconds_bucket[1m]))
          ) > {{ alert_latency_p95_seconds }}
        for: {{ alert_for_duration }}
        labels:
          severity: warning
        annotations:
          summary: "p95 latency above {{ alert_latency_p95_seconds }}s"
          description: "Current p95 latency: {% raw %}{{ $value | humanizeDuration }}{% endraw %}."
